{
  "name": "vue-magic-cursor",
  "version": "1.0.1",
  "private": false,
  "license": "MIT",
  "author": "Ronny Susanto",
  "keywords": [
    "frontend",
    "vue.js",
    "javascript",
    "web-development",
    "animation",
    "custom-cursor",
    "cursor",
    "animated-cursor",
    "effects",
    "design"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/magic-cursor.umd.cjs",
  "module": "./dist/magic-cursor.js",
  "exports": {
    ".": {
      "import": "./dist/magic-cursor.js",
      "require": "./dist/magic-cursor.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "exclude": [
    "src/App.vue",
    "src/main.js"
  ],
  "scripts": {
    "dev": "vite --config docs-src/vite.config.js docs-src",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "docs:dev": "vite --config docs-src/vite.config.js docs-src",
    "docs:build": "vite build --config docs-src/vite.config.js docs-src",
    "docs:preview": "vite preview --config docs-src/vite.config.js --outDir docs"
  },
  "dependencies": {
    "vue": "^3.4.29"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "sass-embedded": "^1.77.8",
    "vite": "^5.3.1"
  }
}
